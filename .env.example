# ---------------------------------------------------------------------------
# Agent Network Studio — environment configuration
#
# Copy this file to `.env.local` and fill in your own values:
#   cp .env.example .env.local
#
# `.env.local` and `.env.bundled` are gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# OAuth Connected App credentials from Anypoint Platform.
# Create a Connected App (App type) in Anypoint > Access Management and grant
# it the scopes your deployment needs. This is a server-side OAuth client
# secret, NOT a user password.
ANYPOINT_CLIENT_ID=
ANYPOINT_CLIENT_SECRET=

# Secret used to encrypt the iron-session cookie.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- Optional: OAuth redirect / control plane -----------------------------

# Must match a redirect URI registered on your Connected App.
# Defaults to http://localhost:3000/auth/callback for local development.
# ANYPOINT_REDIRECT_URI=http://localhost:3000/auth/callback

# Override the Anypoint control-plane base URL (US control plane by default).
# ANYPOINT_BASE_URL=https://anypoint.mulesoft.com

# Override the default OAuth scope set (space-delimited).
# ANYPOINT_SCOPES=

# --- Optional: additional control-plane regions ---------------------------
# Only set these if you operate Connected Apps in other control planes.

# EU control plane (eu1.anypoint.mulesoft.com)
# ANYPOINT_EU_CLIENT_ID=
# ANYPOINT_EU_CLIENT_SECRET=

# CA / JP control planes (coming soon)
# ANYPOINT_CA_CLIENT_ID=
# ANYPOINT_CA_CLIENT_SECRET=
# ANYPOINT_JP_CLIENT_ID=
# ANYPOINT_JP_CLIENT_SECRET=

# --- Optional: Anypoint CLI integration -----------------------------------
# Only used by lifecycle worker execution (Build & Publish).
# Override auto-discovery if the Anypoint CLI or its Node runtime live in a
# non-standard location.
# ANYPOINT_CLI_PATH=
# ANYPOINT_NODE_PATH=

# --- Lifecycle (Build & Publish) — in-process on Fly ----------------------
# The web app enqueues build/publish/deploy jobs directly to Redis; a separate
# worker process (lifecycle-worker.ts) drains the queue and runs the Anypoint
# CLI. Set REDIS_URL to point both the web server and the worker at Redis.
# Locally: run redis (e.g. docker run -p 6379:6379 redis:7) and the worker
#   (npm run worker). Defaults to redis://localhost:6379 when unset.
# On Fly: point at the private self-hosted Redis app, e.g.
#   redis://default:<password>@<redis-app>.flycast:6379
# REDIS_URL=redis://localhost:6379

# Append --debug to every Anypoint CLI run while troubleshooting (1/0).
# ANYPOINT_CLI_DEBUG=0

# Root dir for per-job temp workspaces on the worker (must be writable).
# WORKSPACE_ROOT=/tmp/anf-jobs

# --- Optional: Ops page (operator diagnostics) ----------------------------
# Comma-separated Anypoint org ids allowed to see the operator-only /ops page.
# Leave unset and nobody can reach it (the gate fails closed) — /ops and every
# /api/ops route return 403. Business group ids work as well as root org ids.
# OPS_ORG_IDS=

# The /ops page reads Redis and the build queue with no extra configuration.
# To also list and control Fly machines from it, give the app a Fly API token:
#   fly secrets set FLY_API_TOKEN="$(fly tokens create deploy -x 8760h)"
# FLY_APP_NAME is injected automatically on Fly, so the token is all that is
# needed there. Without it the page still renders and says the Fly section is
# unavailable.
# FLY_API_TOKEN=
# FLY_APP_NAME=agent-network-tracer

# --- Optional: diagnostics ------------------------------------------------
# Enable verbose API request logging in development.
# ENABLE_API_LOGGING=1

# Log full request/response bodies. Very expensive — leave off unless you are
# inspecting a specific payload, and never while measuring latency.
# DEBUG_FULL_RESPONSES=1

# Add org-wide and wildcard probe queries to /api/broker-tasks to explain why a
# broker returned no tasks. Costs several extra Log Search round trips per
# request, so keep it off unless you are diagnosing task discovery.
# NEXT_PUBLIC_MSEARCH_DIAGNOSTICS=1

# --- Optional: in-app bug reports -----------------------------------------
# Fine-grained GitHub PAT with Issues: Read and write on the feedback repo.
# When unset, the bug icon still works but submission falls back to email /
# copy debug bundle only.
#
# Note: issues filed this way include the reporter's route, app version, and
# recent console output. On a public repo those become publicly visible, so
# leave this unset unless you want reports published.
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=MuleSoft-Forge/mulesoftforge-agent-network-tracer

# Contact address shown on the privacy page and offered as the bug-report
# fallback. Deliberately not hardcoded, so a public mirror of this source does
# not publish it. When unset, the mailto affordances are simply not rendered.
# FEEDBACK_CONTACT_EMAIL=
