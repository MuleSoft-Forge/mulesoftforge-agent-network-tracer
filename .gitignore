# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Dependencies ---------------------------------------------------------
/node_modules
/.pnp
.pnp.js

# --- Build output ---------------------------------------------------------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# --- Secrets and credentials ---------------------------------------------
# Never commit real credentials. `.env.example` is the only env file tracked.
.env
.env*.local
.env.bundled
**/.env.bundled
*.pem
*.key
*.p12
*.pfx
credentials.json
**/credentials.json
auth.json
**/auth.json

# --- Runtime state --------------------------------------------------------
# Redis dumps contain real job logs, org ids, and account identifiers.
*.rdb
dump.rdb

# --- Local-only working area ---------------------------------------------
# Kept on the maintainer's machine as build context; never published.
deprecated/
private/
hidefromgit/

# --- Local tooling and editor config -------------------------------------
.cursor/
.claude/
.vscode/
.idea/
.cache/
.vercel
vercel-source-download/

# --- Scratch virtualenvs --------------------------------------------------
.venv
.venv-*/
venv/
__pycache__/

# --- Logs -----------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
