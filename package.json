{
  "name": "mulesoftforge-agent-network-tracer",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx scripts/composer-test.mts",
    "check": "tsc --noEmit && npm run lint && npm test",
    "sync:anf-schemas": "tsx scripts/sync-anf-schemas.mts",
    "sync:composer-examples": "tsx scripts/sync-composer-examples.mts",
    "deploy": "npx vercel --prod --yes",
    "reset": "bash reset.sh",
    "start:clean": "bash start-clean.sh",
    "electron:dev": "cross-env ELECTRON_DEV=1 ELECTRON_DESKTOP=1 ELECTRON_RUN_AS_NODE= concurrently -k -n next,electron -c blue,green \"next dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_RUN_AS_NODE= electron .\"",
    "electron:assemble": "node electron/assemble-standalone.mjs",
    "electron:pack": "npm run build && npm run electron:assemble && electron-builder --dir",
    "electron:dist": "npm run build && npm run electron:assemble && electron-builder -mw",
    "electron:install-local": "npm run electron:pack && node electron/install-local.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@sf-agentscript/agentfabric-dialect": "^1.1.3",
    "@sf-agentscript/agentforce": "^2.5.34",
    "@sf-agentscript/language": "^2.19.3",
    "@sf-agentscript/monaco": "^2.2.17",
    "@xyflow/react": "^12.11.2",
    "ajv": "^8.20.0",
    "iron-session": "^8.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "monaco-editor": "0.50.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^15.5.12"
  },
  "build": {
    "appId": "com.mulesoftforge.agent-network-tracer",
    "productName": "Agent Network Tracer",
    "directories": {
      "output": "electron-out"
    },
    "files": [
      "electron/**/*",
      "!electron/assemble-standalone.mjs",
      "!electron/after-pack.js",
      "!electron/install-local.mjs",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "electron-dist/app-standalone",
        "to": "app-standalone"
      }
    ],
    "afterPack": "electron/after-pack.js",
    "asar": true,
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "electron/assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.png"
    }
  }
}
