# VCS / editor / OS
.git
.gitignore
.vscode
.cursor
.claude
.DS_Store

# Installed/built inside the image
node_modules
.next
tsconfig.tsbuildinfo

# Local env & secrets — never bake these into the image
.env
.env.local
.env.bundled
.env*.local

# Desktop / Electron build outputs (not part of the web image)
electron-dist
electron-out

# Local-only tooling, scratch, and previous platform metadata
private
hidefromgit
.venv-temp
.vercel
*.log

# Not needed at build/runtime
docs
examples

# Separate deployable (deploys to Vercel, not part of this image) — its own
# node_modules alone is >100MB and was bloating the Fly build context.
invoke-egress-proxy

# Local-only archive of superseded code — huge (~475 MB), untracked, and never
# part of the image. Leaving it out of the context keeps deploy uploads small.
deprecated
