{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Network Specification",
  "@context": {
    "@type": [
      "http://anypoint.com/vocabs/agents#Network"
    ],
    "@base": "http://anypoint.com/vocabs/agents#"
  },
  "type": "object",
  "required": [
    "agentNetwork"
  ],
  "anyOf": [
    {
      "required": [
        "registry"
      ]
    },
    {
      "required": [
        "context"
      ]
    },
    {
      "required": [
        "brokers"
      ]
    }
  ],
  "properties": {
    "agentNetwork": {
      "type": "string",
      "const": "2.0.0",
      "description": "This string MUST be the version number of the Agent Network Specification that the Agent Network Document uses. The agent-network field SHOULD be used by tooling to interpret the Agent Network Document. This is not related to the document's info.version property."
    },
    "info": {
      "$ref": "#/definitions/NetworkInfoObject"
    },
    "registry": {
      "$ref": "#/definitions/Registry"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reusable entities scoped to this document (e.g., connections, policies)",
      "properties": {
        "connections": {
          "$ref": "#/definitions/Connections",
          "description": "The list of connections defined as part of this network."
        },
        "policies": {
          "$ref": "#/definitions/Policies",
          "description": "The list of policies defined as part of this network."
        }
      }
    },
    "brokers": {
      "$ref": "#/definitions/Brokers",
      "description": "The list of Brokers defined as part of this network."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Brokers": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#brokers"
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "description": "The declared brokers.",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/BrokerEntity"
        }
      }
    },
    "BrokerEntity": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Agent",
          "http://anypoint.com/vocabs/agents#Broker"
        ]
      },
      "description": "A broker agent that orchestrates other agents.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation",
        "interfaces"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/InfoObject"
        },
        "kind": {
          "type": "string",
          "const": "AgentScript",
          "description": "The type of agent implementation"
        },
        "implementation": {
          "description": "The Path to the AgentScript implementation file.",
          "type": "string"
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": false,
          "description": "The interfaces that this broker supports",
          "anyOf": [
            {
              "required": [
                "a2a"
              ]
            }
          ],
          "properties": {
            "a2a": {
              "type": "object",
              "additionalProperties": false,
              "description": "A2A protocol version 1.x interface configuration",
              "properties": {
                "card": {
                  "$ref": "a2a_v1.json#/definitions/Agent Card",
                  "description": "The A2A v1 agent card definition"
                },
                "policies": {
                  "description": "The Policies that are going to be applied to the agent with this interface",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "inbound": {
                      "$ref": "#/definitions/PolicyBindings",
                      "description": "Policies applied to inbound traffic"
                    },
                    "outbound": {
                      "$ref": "#/definitions/PolicyBindings",
                      "description": "Policies applied to outbound traffic"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Registry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Definitions intended for publication and reusability in the agent registry (agents, MCP servers, LLMs)",
      "properties": {
        "agents": {
          "$ref": "#/definitions/Agents",
          "description": "The list of agents defined as part of this network."
        },
        "mcps": {
          "$ref": "#/definitions/MCPs",
          "description": "The list of MCP servers defined as part of this network."
        },
        "llms": {
          "$ref": "#/definitions/LLMs",
          "description": "The list of LLM providers defined as part of this network."
        }
      }
    },
    "InfoObject": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata object providing descriptive information (base object that can be extended)",
      "properties": {
        "label": {
          "type": "string",
          "description": "The human readable short text"
        },
        "description": {
          "type": "string",
          "description": "A human readable text of what it does. CommonMark syntax MAY be used for rich text representation."
        },
        "tags": {
          "type": "array",
          "description": "A list of tags for categorization and search",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NetworkInfoObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "version"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "description": "A short summary of the Agent Network purpose"
        },
        "termsOfService": {
          "type": "string",
          "description": "A URI for the Terms of Service for the API. This MUST be in the form of a URI"
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "description": "The contact information for the Agent Network",
          "properties": {
            "name": {
              "type": "string",
              "description": "The identifying name of the contact person/organization"
            },
            "url": {
              "type": "string",
              "description": "The URI for the contact information. This MUST be in the form of a URI"
            },
            "email": {
              "type": "string",
              "description": "The email address of the contact person/organization. This MUST be in the form of an email address"
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "description": "The license information for the Agent Network",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "The license name used for the Agent Network"
            },
            "identifier": {
              "type": "string",
              "description": "An SPDX license expression for the API. The `identifier` field is mutually exclusive of the `url` field"
            },
            "url": {
              "type": "string",
              "description": "A URI for the license used for the API. This MUST be in the form of a URI. The `url` field is mutually exclusive of the `identifier` field"
            }
          }
        },
        "version": {
          "type": "string",
          "description": "A version for this element"
        },
        "label": {
          "type": "string",
          "description": "The human readable short text"
        },
        "description": {
          "type": "string",
          "description": "A human readable text of what it does. CommonMark syntax MAY be used for rich text representation."
        },
        "tags": {
          "type": "array",
          "description": "A list of tags for categorization and search",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Policies": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#policybinding"
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "description": "The declared policies",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/PolicyBinding"
        }
      }
    },
    "PolicyBindingRef": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Reference",
          "http://anypoint.com/vocabs/agents/reference/kind#policybinding"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "description": "The reference to a declared policy binding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "The name of the policy binding to reference",
          "type": "string"
        },
        "namespace": {
          "description": "Optional namespace to scope the policy reference",
          "type": "string"
        }
      }
    },
    "PolicyBinding": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#PolicyBinding"
        ]
      },
      "description": "The policy to be applied",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "configuration"
      ],
      "properties": {
        "ref": {
          "$ref": "references.json#/definitions/PolicyRef",
          "description": "Reference to the policy definition"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": true,
          "description": "Policy-specific configuration parameters"
        },
        "access": {
          "type": "string",
          "description": "The access modifier associated to the element",
          "enum": ["internal", "shared"],
          "default": "internal"
        }
      }
    },
    "PolicyBindings": {
      "description": "An array of policy bindings that can be applied to connections or interfaces",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "$ref": "#/definitions/PolicyBindingRef"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy"
            ],
            "properties": {
              "policy": {
                "$ref": "#/definitions/PolicyBinding",
                "description": "An inline policy binding"
              }
            }
          }
        ]
      }
    },
    "Agents": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#agent"
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "description": "The declared agents",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/AgentEntity"
        }
      }
    },
    "LLMs": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#llm"
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "description": "The declared LLM providers",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/LLMEntity"
        }
      }
    },
    "MCPs": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#mcp"
        ]
      },
      "type": "object",
      "additionalProperties": false,
      "description": "The declared MCP servers",
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/MCPServerEntity"
        }
      }
    },
    "BasicAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#BasicAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "title": "Basic Authentication",
      "description": "Properties for Basic Authentication.",
      "additionalProperties": false,
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'basic' for Basic Authentication",
          "const": "basic",
          "type": "string"
        },
        "username": {
          "type": "string",
          "description": "The username for authentication."
        },
        "password": {
          "type": "string",
          "description": "The password for authentication."
        },
        "headerName": {
          "type": "string",
          "description": "The name of the header where to set the key. If not specified 'Authorization' is set by default."
        }
      }
    },
    "ApiKeyClientCredentialsAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#ApiKeyClientCredentialsAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clientId",
        "clientSecret"
      ],
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'apikey-client-credentials' for API Key Client Credentials Authentication",
          "const": "apikey-client-credentials",
          "type": "string"
        },
        "clientId": {
          "type": "object",
          "description": "The client ID.",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "description": "The value for the clientId"
            },
            "name": {
              "type": "string",
              "description": "The name for the clientId by default is going to be 'client_id'"
            }
          }
        },
        "clientSecret": {
          "type": "object",
          "description": "The client secret.",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "description": "The value for the clientSecret"
            },
            "name": {
              "type": "string",
              "description": "The name for the clientSecret by default is going to be 'client_secret'"
            }
          }
        }
      }
    },
    "APIKeyAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#APIKeyAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiKey"
      ],
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'apiKey' for API Key Authentication",
          "const": "apiKey",
          "type": "string"
        },
        "headerName": {
          "description": "The name of the header to be used. If not specified Authorization is used.",
          "type": "string"
        },
        "apiKey": {
          "type": "string",
          "description": "The value of the apiKey"
        }
      }
    },
    "OAuth2ClientCredentialsAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#OAuth2ClientCredentialsAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clientId",
        "clientSecret",
        "token"
      ],
      "title": "OAuth 2.0 Client Credentials Grant",
      "description": "Properties for the OAuth 2.0 Client Credentials Grant Type.",
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'oauth2-client-credentials' for OAuth 2.0 Client Credentials Authentication",
          "const": "oauth2-client-credentials",
          "type": "string"
        },
        "clientId": {
          "type": "string",
          "description": "The client ID."
        },
        "clientSecret": {
          "type": "string",
          "description": "The client secret."
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "description": "Configuration on how to fetch the token.",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "description": "The url of the token provider"
            },
            "timeout": {
              "type": "number",
              "description": "Time in seconds to wait for the service to return the token."
            },
            "bodyEncoding": {
              "type": "string",
              "description": "Content encoding for the request body. Must be 'form' (application/x-www-form-urlencoded) or 'json' (application/json)",
              "enum": [
                "form",
                "json"
              ]
            }
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "An array of scopes to request."
        }
      }
    },
    "OAuth2OBOCredentialsAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#OAuth2OBOCredentialsAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "title": "OAuth2 OBO Credential Injection",
      "description": "Exchanges incoming bearer token for a new token targeting an upstream service using OAuth 2.0 Token Exchange (RFC 8693) or Microsoft Entra ID On-Behalf-Of flow",
      "required": [
        "kind",
        "flow",
        "clientId",
        "clientSecret",
        "tokenEndpoint"
      ],
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'oauth2-obo' for OAuth 2.0 On-Behalf-Of Authentication",
          "const": "oauth2-obo",
          "type": "string"
        },
        "flow": {
          "type": "string",
          "enum": [
            "oauth2-token-exchange",
            "microsoft-entra-obo"
          ],
          "description": "Select the token exchange flow type - Standard OAuth 2.0 Token Exchange (RFC 8693) or Microsoft Entra ID On-Behalf-Of flow."
        },
        "clientId": {
          "type": "string",
          "description": "The OAuth2 client ID for token exchange."
        },
        "clientSecret": {
          "type": "string",
          "description": "The OAuth2 client secret for token exchange."
        },
        "tokenEndpoint": {
          "type": "string",
          "description": "The OAuth2 token endpoint URL for token exchange."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "audience",
            "resource"
          ],
          "default": "audience",
          "description": "The parameter type for specifying the target service (audience for logical name, resource for physical URI). Used for OAuth 2.0 Token Exchange (RFC 8693)."
        },
        "targetValue": {
          "type": "string",
          "description": "The target audience URI or resource URI for the exchanged token. Required for OAuth 2.0 Token Exchange (RFC 8693)."
        },
        "scope": {
          "type": "string",
          "description": "OAuth scope to request. Optional for OAuth 2.0 Token Exchange (RFC 8693). Required for Microsoft Entra OBO (e.g., 'api://downstream-client-id/.default')."
        },
        "timeout": {
          "type": "integer",
          "default": 10000,
          "description": "Timeout for token exchange requests in milliseconds."
        },
        "cibaEnabled": {
          "type": "boolean",
          "description": "When enabled, the policy uses Client Initiated Backchannel Authentication (CIBA) instead of the standard OBO token exchange. Only valid for the oauth2-token-exchange flow. Default is false.",
          "default": false
        },
        "cibaEndpoint": {
          "type": "string",
          "description": "bc-authorize endpoint for Client Initiated Backchannel Authentication (CIBA)."
        },
        "cibaLoginHintClaim": {
          "type": "string",
          "description": "JWT claim from the subject token to use as the CIBA login_hint (e.g., email, sub, preferred_username).\n\n",
          "default": "email"
        },
        "cibaBindingMessage": {
          "type": "string",
          "description": "Optional human-readable message shown to the user on their authentication device during the CIBA approval flow."
        },
        "distributed": {
          "type": "boolean",
          "default": "false",
          "description": "Share token cache across replicas. Required for fully managed gateway or any multi-replica deployment."
        }
      }
    },
    "InTaskAuthorizationCodeAuth": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#InTaskAuthorizationCodeAuth",
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "title": "In-Task Authorization Code",
      "description": "Handles secondary credentials for in-task authentication using OAuth 2.0 Authorization Code flow. Extracts OAuth2 tokens from message data and injects them into Authorization headers for upstream calls.",
      "required": [
        "kind",
        "authorizationEndpoint",
        "tokenEndpoint",
        "scopes",
        "redirectUri"
      ],
      "properties": {
        "kind": {
          "description": "The authentication type - must be 'in-task-authorization-code' for In-Task Authorization Code Authentication",
          "const": "in-task-authorization-code",
          "type": "string"
        },
        "secondaryAuthProvider": {
          "type": "string",
          "default": "",
          "description": "Name of the IdP provider (e.g., 'okta', 'auth0'). Used for informational purposes in the authentication card."
        },
        "authorizationEndpoint": {
          "type": "string",
          "description": "OAuth2 authorization endpoint URL (e.g., 'https://domain/oauth2/v1/authorize'). Required for generating the authentication challenge."
        },
        "tokenEndpoint": {
          "type": "string",
          "description": "OAuth2 token endpoint URL (e.g., 'https://domain/oauth2/v1/token'). Required for generating the authentication challenge."
        },
        "scopes": {
          "type": "string",
          "description": "Space or comma separated list of OAuth2 scopes required for step-up authentication (e.g., 'openid profile email transaction:execute')."
        },
        "redirectUri": {
          "type": "string",
          "description": "OAuth2 redirect URI that the client will use in the authorization flow."
        },
        "responseType": {
          "type": "string",
          "default": "code",
          "description": "OAuth2 response type. Typically 'code' for authorization code flow."
        },
        "codeChallengeMethod": {
          "type": "string",
          "default": "S256",
          "description": "PKCE code challenge method. Typically 'S256' for SHA-256."
        },
        "tokenAudience": {
          "type": "string",
          "description": "OAuth2 token audience. The intended recipient of the token (e.g., 'https://hr-a2a-agent.example.com')."
        },
        "bodyEncoding": {
          "type": "string",
          "default": "form",
          "description": "Encoding format for token request body. Typically 'form' for application/x-www-form-urlencoded."
        },
        "tokenTimeout": {
          "type": "integer",
          "default": 300,
          "description": "Timeout in seconds for token requests."
        },
        "challengeResponseStatusCode": {
          "type": "integer",
          "default": 200,
          "description": "HTTP status code to return for auth-required challenge responses. Typically 200 to maintain JSON-RPC compatibility."
        },
        "distributed": {
          "type": "boolean",
          "default": false,
          "description": "Share token cache across replicas. Required for fully managed gateway or any multi-replica deployment."
        },
        "subjectTokenType": {
          "type": "string",
          "description": "The token type identifier for the subject token.",
          "default": "urn:ietf:params:oauth:token-type:access_token"
        },
        "requestedTokenType": {
          "type": "string",
          "description": "The desired token type for the issued token."
        }
      }
    },
    "Authentication": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Authentication"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "anyOf": [
        {
          "$ref": "#/definitions/OAuth2ClientCredentialsAuth"
        },
        {
          "$ref": "#/definitions/BasicAuth"
        },
        {
          "$ref": "#/definitions/ApiKeyClientCredentialsAuth"
        },
        {
          "$ref": "#/definitions/APIKeyAuth"
        },
        {
          "$ref": "#/definitions/OAuth2OBOCredentialsAuth"
        },
        {
          "$ref": "#/definitions/InTaskAuthorizationCodeAuth"
        }
      ]
    },
    "AgentConnection": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Connection",
          "http://anypoint.com/vocabs/agents#AgentConnection"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "description": "Defines a connection to an agent that exists outside of this domain",
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "description": "The connection type - must be 'a2a' for Agent-to-Agent connections",
          "const": "a2a",
          "type": "string"
        },
        "ref": {
          "$ref": "references.json#/definitions/AgentRef"
        },
        "url": {
          "type": "string",
          "description": "The base URL for the Agent"
        },
        "authentication": {
          "description": "The authentication to use when connecting to the MCP server",
          "$ref": "#/definitions/Authentication"
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "description": "Policies to apply to this connection",
          "properties": {
            "inbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to inbound traffic"
            },
            "outbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to outbound traffic"
            }
          }
        },
        "access": {
          "type": "string",
          "description": "The access modifier associated to the element",
          "enum": ["internal", "shared"],
          "default": "internal"
        }
      }
    },
    "LLMConnection": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Connection",
          "http://anypoint.com/vocabs/agents#LLMConnection"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "description": "Defines a connection to a LLM that exists outside of this domain",
      "required": [
        "kind",
        "ref",
        "authentication"
      ],
      "properties": {
        "kind": {
          "description": "The connection type - must be 'llm' for LLM connections",
          "const": "llm",
          "type": "string"
        },
        "ref": {
          "$ref": "references.json#/definitions/LLMRef"
        },
        "url": {
          "type": "string",
          "description": "The base URL for the LLM"
        },
        "authentication": {
          "$ref": "#/definitions/LLMAuthentication",
          "description": "The Authentication to use when connecting to the LLM"
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "description": "Policies to apply to this connection",
          "properties": {
            "inbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to inbound traffic"
            },
            "outbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to outbound traffic"
            }
          }
        },
        "access": {
          "type": "string",
          "description": "The access modifier associated to the element",
          "enum": ["internal", "shared"],
          "default": "internal"
        }
      }
    },
    "LLMAuthentication": {
      "oneOf": [
        {
          "$ref": "#/definitions/ApiKey"
        }
      ]
    },
    "ApiKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "apiKey"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "apiKey",
          "description": "ApiKey authentication type used for this provider"
        },
        "apiKey": {
          "description": "The API Key used for authenticating against the LLM",
          "type": "string"
        }
      }
    },
    "MCPServerConnection": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Connection",
          "http://anypoint.com/vocabs/agents#MCPServerConnection"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "description": "Defines a connection to a MCP Server that exists outside of this domain",
      "required": [
        "ref",
        "kind"
      ],
      "properties": {
        "kind": {
          "description": "The connection type - must be 'mcp' for MCP server connections",
          "const": "mcp",
          "type": "string"
        },
        "ref": {
          "$ref": "references.json#/definitions/MCPRef"
        },
        "url": {
          "type": "string",
          "description": "The base URL for the MCP server"
        },
        "authentication": {
          "$ref": "#/definitions/Authentication",
          "description": "The Authentication to use when connecting to the MCP server"
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "description": "Policies to apply to this connection",
          "properties": {
            "inbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to inbound traffic"
            },
            "outbound": {
              "$ref": "#/definitions/PolicyBindings",
              "description": "Policies applied to outbound traffic"
            }
          }
        },
        "access": {
          "type": "string",
          "description": "The access modifier associated to the element",
          "enum": ["internal", "shared"],
          "default": "internal"
        }
      }
    },
    "ConnectionElement": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Connection"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "anyOf": [
        {
          "$ref": "#/definitions/LLMConnection"
        },
        {
          "$ref": "#/definitions/AgentConnection"
        },
        {
          "$ref": "#/definitions/MCPServerConnection"
        }
      ]
    },
    "Connections": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#DeclarationDefinitions",
          "http://anypoint.com/vocabs/agents/reference/kind#connection"
        ]
      },
      "description": "Connection elements",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_.-]*[a-zA-Z0-9]$": {
          "$ref": "#/definitions/ConnectionElement"
        }
      }
    },
    "AgentEntity": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#Agent"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/InfoObject"
        },
        "metadata": {
          "description": "Metadata describing the agent's platform, protocol, and integrations",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "interfaces"
          ],
          "properties": {
            "platform": {
              "$ref": "agent_metadata.json#/definitions/AgentMetadata/properties/platform"
            },
            "interfaces": {
              "description": "The interfaces that this agent supports",
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "a2a"
                  ]
                },
                {
                  "required": [
                    "a2a_v03"
                  ]
                },
                {
                  "required": [
                    "other"
                  ]
                }
              ],
              "properties": {
                "a2a_v03": {
                  "description": "A2A protocol version 0.3.x interface definition",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "card": {
                      "$ref": "a2a.json#/definitions/AgentCard"
                    }
                  }
                },
                "a2a": {
                  "description": "A2A protocol version 1.x interface definition",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "card": {
                      "$ref": "a2a_v1.json#/definitions/Agent Card"
                    }
                  }
                },
                "other": {
                  "description": "Other protocol interface definition",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["protocol"],
                  "properties": {
                    "protocol": {
                      "description": "The protocol name for this interface",
                      "type": "string"
                    },
                    "card": {
                      "$ref": "other_card.json#/definitions/OtherCard"
                    }
                  }
                }
              }
            },
            "tools": {
              "description": "The list of tool providers",
              "type": "array",
              "items": {
                "$ref": "#/definitions/ToolsRef"
              }
            },
            "llm": {
              "type": "object",
              "additionalProperties": false,
              "description": "The LLM provider used by this agent",
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "$ref": "references.json#/definitions/LLMRef",
                  "description": "Reference to the LLM provider"
                }
              }
            }
          }
        },
        "urls": {
          "$ref": "#/definitions/Urls"
        }
      }
    },
    "ToolsRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mcp"
          ],
          "properties": {
            "mcp": {
              "description": "Reference to an MCP server that provides tools",
              "type": "object",
              "required": [
                "ref"
              ],
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "$ref": "references.json#/definitions/MCPRef"
                },
                "allowed": {
                  "description": "An optional list of tool names from the MCP server that are allowed to be used",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_-]*$",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "a2a"
          ],
          "properties": {
            "a2a": {
              "description": "Reference to an A2A agent that can be used as a tool",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "$ref": "references.json#/definitions/AgentRef"
                }
              }
            }
          }
        }
      ]
    },
    "LLMEntity": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#LLM"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/InfoObject"
        },
        "metadata": {
          "$ref": "#/definitions/LLMMetadata"
        },
        "urls": {
          "$ref": "#/definitions/Urls"
        }
      }
    },
    "LLMMetadata": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#LLMMetadata"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform"
      ],
      "properties": {
        "platform": {
          "description": "The LLM platform provider (e.g., 'Gemini', 'OpenAI', 'AzureOpenai')",
          "type": "string",
          "enum": [
            "Gemini",
            "OpenAI",
            "AzureOpenai"
          ]
        },
        "models": {
          "description": "An array of model identifiers available on this LLM platform",
          "type": "array",
          "items": {
            "type": "string",
            "description": "A model identifier (e.g., 'gpt-4', 'gemini-pro')"
          }
        }
      }
    },
    "Urls": {
      "description": "An array of named URLs associated with this resource",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "description": "A named URL entry",
        "properties": {
          "name": {
            "type": "string",
            "description": "A descriptive name for this URL (e.g., 'production', 'staging', 'development')"
          },
          "url": {
            "type": "string",
            "description": "The URL value"
          }
        },
        "required": [
          "url",
          "name"
        ]
      }
    },
    "MCPServerEntity": {
      "@context": {
        "@type": [
          "http://anypoint.com/vocabs/agents#MCPServer"
        ],
        "@base": "http://anypoint.com/vocabs/agents#"
      },
      "description": "The definition of the MCP Server entity",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata"
      ],
      "properties": {
        "info": {
          "$ref": "#/definitions/InfoObject"
        },
        "urls": {
          "$ref": "#/definitions/Urls"
        },
        "metadata": {
          "$ref": "mcp_metadata.json#/definitions/MCPServer"
        }
      }
    }
  }
}
